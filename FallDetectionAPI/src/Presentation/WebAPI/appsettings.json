{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=fall_detection;Username=postgres;Password=postgres"
  },
  "AiService": {
    "BaseUrl": "http://ai-service:8000"
  },
  "MockCamera": {
    "BaseUrl": "http://mock-camera-service:8001",
    "HlsBaseUrl": "http://localhost:8888",
    "HlsPublicBaseUrl": "",
    "StreamPathPrefix": "/live",
    "MaxCameraProbe": 0,
    "MinCameraProbe": 8,
    "ConsecutiveMissStopThreshold": 4
  },
  "SignalRHost": {
    "BaseUrl": "http://fall_detection_signalr:8081"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Queue": {
    "Capacity": 600,
    "FlushIntervalMs": 1000,
    "MaxBatchSize": 10
  }
}
