meta {
  name: Results hashes
  type: http
  seq: 4
}

get {
  url: {{webApiBase}}/api/results/hashes
  body: none
  auth: none
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("hash list payload", function () {
    var body = res.getBody();
    expect(Array.isArray(body.hashes)).to.equal(true);
    expect(body.total_hashes).to.not.equal(undefined);
  });
}
