meta {
  name: Results health net-api
  type: http
  seq: 9
}

get {
  url: {{webApiBase}}/api/results/health/net-api
  body: none
  auth: none
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("net-api health payload", function () {
    var body = res.getBody();
    expect(body.health).to.not.equal(undefined);
    expect(body.health.status).to.equal("healthy");
  });
}
