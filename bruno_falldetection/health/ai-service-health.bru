meta {
  name: AI Service health
  type: http
  seq: 2
}

get {
  url: {{aiServiceBase}}/health
  body: none
  auth: none
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("has status field", function () {
    var body = res.getBody();
    expect(body.status).to.not.equal(undefined);
  });
}
