meta {
  name: Camera videos
  type: http
  seq: 6
}

get {
  url: {{webApiBase}}/api/camera/videos
  body: none
  auth: none
}

tests {
  test("status 200 or 503", function () {
    expect([200, 503]).to.include(res.getStatus());
  });

  test("status error payload when unavailable", function () {
    if (res.getStatus() === 503) {
      var body = res.getBody();
      expect(body.error).to.equal("Camera service unavailable");
    }
  });
}
