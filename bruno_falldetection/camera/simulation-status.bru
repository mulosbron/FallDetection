meta {
  name: Camera simulation status
  type: http
  seq: 7
}

get {
  url: {{webApiBase}}/api/camera/simulation-status
  body: none
  auth: none
}

tests {
  test("status 200 or 503", function () {
    expect([200, 503]).to.include(res.getStatus());
  });

  test("simulation payload when service is available", function () {
    if (res.getStatus() === 200) {
      var body = res.getBody();
      expect(body.simulation).to.not.equal(undefined);
      expect(body.alertStatus).to.not.equal(undefined);
    }
  });

  test("status error payload when unavailable", function () {
    if (res.getStatus() === 503) {
      var body = res.getBody();
      expect(body.error).to.equal("Camera service unavailable");
    }
  });
}
