meta {
  name: Camera stop simulation
  type: http
  seq: 4
}

post {
  url: {{webApiBase}}/api/camera/stop
  body: none
  auth: none
}

tests {
  test("status 200, 503 or temporary 500", function () {
    expect([200, 503, 500]).to.include(res.getStatus());
  });

  test("error payload when unavailable", function () {
    if (res.getStatus() === 503) {
      var body = res.getBody();
      expect(body.error).to.equal("Camera simulation service unavailable");
    }
  });
}
