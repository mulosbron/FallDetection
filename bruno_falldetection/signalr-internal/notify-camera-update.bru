meta {
  name: Notify camera-update
  type: http
  seq: 2
}

post {
  url: {{signalrBase}}/internal/notify/camera-update
  body: json
  auth: none
}

body:json {
  {
    "cameraId": "cam-001",
    "cameraName": "Kamera 1",
    "timestamp": "2026-01-01T00:00:00Z",
    "result": "No",
    "yesCount": 0,
    "totalCount": 1,
    "threshold": 1
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("published", function () {
    var body = res.getBody();
    expect(body.published).to.equal(true);
  });
}
