meta {
  name: Frames form upload without image
  type: http
  seq: 3
}

post {
  url: {{webApiBase}}/api/frames?cameraId=1
  body: none
  auth: none
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("validation error for missing image", function () {
    var body = res.getBody();
    expect(body.title).to.not.equal(undefined);
    expect(body.errors).to.not.equal(undefined);
    expect(body.errors.image).to.not.equal(undefined);
  });
}
